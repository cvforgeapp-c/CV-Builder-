{% extends "base.html" %}

{% block title %}AI Salary Negotiator — CVForge Pro{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- HEADER -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-extrabold text-[#02353C] tracking-tight">AI Salary Negotiator & Offer Evaluator</h1>
            <p class="text-xs text-slate-500 mt-1">Evaluate incoming job offers, benchmark package value, and generate data-backed counter-offer emails.</p>
        </div>
        <a href="/dashboard" class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1">
            ← {{ t('back_to_dashboard') if t('back_to_dashboard') != 'back_to_dashboard' else 'Back to Dashboard' }}
        </a>
    </div>

    <!-- MAIN WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- LEFT FORM PANEL -->
        <div class="lg:col-span-5 bg-white rounded-xl p-5 border border-slate-200 shadow-2xs space-y-4">
            <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">
                    <i class="fa-solid fa-calculator"></i>
                </div>
                <h2 class="text-sm font-bold text-slate-800">Offer Package Details</h2>
            </div>

            <form id="negotiatorForm" class="space-y-3.5">
                <div>
                    <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Company Name</label>
                    <input type="text" name="company_name" placeholder="e.g. Stripe, Microsoft" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#02353C] outline-none" required />
                </div>

                <div>
                    <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Job Title</label>
                    <input type="text" name="job_title" placeholder="e.g. Senior Full Stack Engineer" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#02353C] outline-none" required />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Offered Base Salary</label>
                        <input type="text" name="base_salary" placeholder="e.g. $120,000 / yr" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#02353C] outline-none" required />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Target Base Goal</label>
                        <input type="text" name="target_salary" placeholder="e.g. $135,000 / yr" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#02353C] outline-none" />
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Bonus, Equity & Signing Bonus</label>
                    <input type="text" name="bonus_equity" placeholder="e.g. $15k sign-on, 10% annual bonus, $20k stock" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#02353C] outline-none" />
                </div>

                <div>
                    <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Negotiation Tone</label>
                    <select name="tone" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#02353C] outline-none">
                        <option value="Professional & Firm">Professional & Firm (Recommended)</option>
                        <option value="Enthusiastic & Collaborative">Enthusiastic & Collaborative</option>
                        <option value="Direct & High Leverage">Direct & High Leverage (Competing Offers)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Additional Perks or Context (Optional)</label>
                    <textarea name="perks_notes" rows="3" placeholder="e.g. Remote setup, competing offers, health insurance details..." class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#02353C] outline-none"></textarea>
                </div>

                <button type="submit" id="evaluateBtn" class="w-full bg-[#02353C] hover:bg-[#034a54] text-amber-400 font-extrabold text-xs py-3 rounded-xl transition-all shadow-sm flex items-center justify-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span id="btnText">Evaluate Offer & Build Counter-Offer</span>
                </button>
            </form>
        </div>

        <!-- RIGHT RESULTS PANEL -->
        <div class="lg:col-span-7 bg-white rounded-xl p-5 border border-slate-200 shadow-2xs space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-xs font-bold">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <h2 class="text-sm font-bold text-slate-800">Negotiation Blueprint</h2>
                </div>
                <span id="offerGradeBadge" class="hidden px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-800">
                    Grade: --
                </span>
            </div>

            <!-- PLACEHOLDER STATE -->
            <div id="resultPlaceholder" class="text-center py-12 space-y-3">
                <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto text-lg">
                    <i class="fa-solid fa-handshake"></i>
                </div>
                <p class="text-xs text-slate-500 max-w-xs mx-auto">Fill in your offer details on the left and click submit to generate your custom negotiation strategy.</p>
            </div>

            <!-- RESULTS CONTENT -->
            <div id="resultContent" class="hidden space-y-4">
                <!-- Evaluation Summary -->
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/80">
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-1">Market Evaluation</h3>
                    <p id="evalSummary" class="text-xs text-slate-600 leading-relaxed"></p>
                </div>

                <!-- Strategic Leverage Points -->
                <div>
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-2">Key Leverage Points</h3>
                    <ul id="strategyList" class="space-y-1.5 text-xs text-slate-700"></ul>
                </div>

                <!-- Counter Offer Email -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Counter-Offer Email Script</h3>
                        <button type="button" onclick="copyCounterEmail()" class="text-[11px] font-bold text-[#02353C] hover:text-emerald-700 flex items-center gap-1">
                            <i class="fa-solid fa-copy"></i> Copy Script
                        </button>
                    </div>

                    <div class="bg-slate-900 text-slate-100 p-4 rounded-xl font-mono text-xs space-y-2 relative">
                        <p class="text-amber-400 font-bold border-b border-slate-800 pb-1.5" id="emailSubject"></p>
                        <p class="whitespace-pre-line text-slate-200 leading-relaxed" id="emailBody"></p>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<script>
    document.getElementById('negotiatorForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const btn = document.getElementById('evaluateBtn');
        const btnText = document.getElementById('btnText');
        
        btn.disabled = true;
        btnText.textContent = 'Analyzing Package...';

        const formData = new FormData(e.target);

        try {
            const response = await fetch('/api/v1/premium/evaluate-offer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(Object.fromEntries(formData))
            });

            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Evaluation failed');

            // Render Output
            document.getElementById('resultPlaceholder').classList.add('hidden');
            document.getElementById('resultContent').classList.remove('hidden');

            const badge = document.getElementById('offerGradeBadge');
            badge.textContent = `Grade: ${data.offer_grade || 'Evaluated'}`;
            badge.classList.remove('hidden');

            document.getElementById('evalSummary').textContent = data.evaluation_summary || '';

            const list = document.getElementById('strategyList');
            list.innerHTML = '';
            (data.strategy_points || []).forEach(pt => {
                const li = document.createElement('li');
                li.className = 'flex items-start gap-2 bg-emerald-50/60 p-2 rounded-lg border border-emerald-100';
                li.innerHTML = `<i class="fa-solid fa-check text-emerald-600 text-xs mt-0.5"></i> <span>${pt}</span>`;
                list.appendChild(li);
            });

            document.getElementById('emailSubject').textContent = `Subject: ${data.counter_email_subject || ''}`;
            document.getElementById('emailBody').textContent = data.counter_email_body || '';

        } catch (err) {
            alert(err.message);
        } finally {
            btn.disabled = false;
            btnText.textContent = 'Evaluate Offer & Build Counter-Offer';
        }
    });

    function copyCounterEmail() {
        const subject = document.getElementById('emailSubject').textContent;
        const body = document.getElementById('emailBody').textContent;
        navigator.clipboard.writeText(`${subject}\n\n${body}`);
        alert('Counter-offer script copied to clipboard!');
    }
</script>
{% endblock %}
